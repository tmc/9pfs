+// StatFS implements p9.File.StatFS.
+//
+// Upstream leaves this unimplemented, so a client sees a volume of unknown
+// size. Report the numbers for the file system actually holding the exported
+// directory.
+func (l *Local) StatFS() (p9.FSStat, error) {
+	var s unix.Statfs_t
+	if err := unix.Statfs(l.path, &s); err != nil {
+		return p9.FSStat{}, err
+	}
+	return p9.FSStat{
+		Type:            s.Type,
+		BlockSize:       s.Bsize,
+		Blocks:          s.Blocks,
+		BlocksFree:      s.Bfree,
+		BlocksAvailable: s.Bavail,
+		Files:           s.Files,
+		FilesFree:       s.Ffree,
+		NameLength:      255,
+	}, nil
