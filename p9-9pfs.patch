 // SetXattr implements p9.File.SetXattr.
+//
+// Txattrcreate turns the fid it is given into a write-only attribute fid, so
+// this walks to a clone of the file first and leaves the receiver's fid usable.
+// The value is written to the clone, and clunking it commits the attribute: the
+// server checks the bytes written against the size declared in Txattrcreate.
 func (c *clientFile) SetXattr(attr string, data []byte, flags XattrFlags) error {
-	return linux.ENOSYS
+	if atomic.LoadUint32(&c.closed) != 0 {
+		return linux.EBADF
+	}
+
+	id, ok := c.client.fidPool.Get()
+	if !ok {
+		return ErrOutOfFIDs
+	}
+
+	// A walk with no names clones the fid without moving it.
+	if err := c.client.sendRecv(&twalk{fid: c.fid, newFID: fid(id)}, &rwalk{}); err != nil {
+		c.client.fidPool.Put(id)
+		return err
+	}
+
+	// newFile + Close clunks the attribute fid and returns it to the pool.
+	xattrFile := c.client.newFile(fid(id))
+	if err := c.client.sendRecv(&txattrcreate{fid: fid(id), Name: attr, AttrSize: uint64(len(data)), Flags: uint32(flags)}, &rxattrcreate{}); err != nil {
+		xattrFile.Close()
+		return err
+	}
+	if len(data) > 0 {
+		if _, err := xattrFile.WriteAt(data, 0); err != nil {
+			xattrFile.Close()
+			return err
+		}
+	}
+	return xattrFile.Close()
 }
 
